upf_version 2.1
create_power_domain PD_CORE -elements {simt_asic_top}
create_supply_port VDD
create_supply_port VSS
create_supply_net VDD -domain PD_CORE
create_supply_net VSS -domain PD_CORE
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_CORE -primary_power_net VDD -primary_ground_net VSS
# Single always-on domain: no isolation, retention, or level shifters.
